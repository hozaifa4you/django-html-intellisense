{
  "name": "django-html-intellisense",
  "displayName": "Django HTML IntelliSense",
  "description": "Full HTML IntelliSense (tags, attributes, values, hover, auto-close, Emmet) in Django templates, without losing Django syntax highlighting.",
  "version": "1.1.0",
  "publisher": "hozaifabinmasud",
  "author": {
    "name": "Hozaifa B. Masud",
    "url": "https://hozaifabinmasud.vercel.app",
    "email": "hozaifa4you@gmail.com"
  },
  "license": "MIT",
  "icon": "assets/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/hozaifa4you/django-html-intellisense"
  },
  "bugs": {
    "url": "https://github.com/hozaifa4you/django-html-intellisense/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "django",
    "django-html",
    "django templates",
    "html",
    "intellisense",
    "autocomplete",
    "attributes",
    "emmet"
  ],
  "activationEvents": [
    "onLanguage:django-html"
  ],
  "main": "./extension.js",
  "contributes": {
    "htmlLanguageParticipants": [
      {
        "languageId": "django-html",
        "autoInsert": true
      }
    ],
    "configurationDefaults": {
      "emmet.includeLanguages": {
        "django-html": "html"
      },
      "[django-html]": {
        "editor.suggest.insertMode": "replace",
        "editor.quickSuggestions": {
          "other": true,
          "comments": true,
          "strings": true
        }
      }
    }
  },
  "scripts": {
    "test": "node --check extension.js && node --test",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.0": true,
    "keytar@7.9.0": true
  }
}
