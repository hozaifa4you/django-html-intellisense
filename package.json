{
  "name": "django-html-intellisense",
  "displayName": "Django HTML IntelliSense",
  "description": "Full HTML IntelliSense (tags, attributes, values, hover, auto-close) in Django templates, without losing Django syntax highlighting.",
  "version": "1.0.0",
  "publisher": "hozaifabinmasud",
  "author": {
    "name": "Hozaifa B. Masud"
  },
  "license": "MIT",
  "icon": "assets/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/hozaifa4you/django-html-intellisense"
  },
  "bugs": {
    "url": "https://github.com/hozaifa4you/django-html-intellisense/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "django",
    "django-html",
    "django templates",
    "html",
    "intellisense",
    "autocomplete",
    "attributes"
  ],
  "activationEvents": [
    "onLanguage:django-html"
  ],
  "main": "./extension.js",
  "contributes": {
    "htmlLanguageParticipants": [
      {
        "languageId": "django-html",
        "autoInsert": true
      }
    ]
  },
  "scripts": {
    "test": "node --check extension.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.0": true,
    "keytar@7.9.0": true
  }
}
