{
  "name": "django-html-intellisense",
  "displayName": "Django HTML IntelliSense",
  "description": "Full HTML IntelliSense (tags, attributes, values, hover, auto-close) in Django templates, without losing Django syntax highlighting.",
  "version": "0.1.0",
  "publisher": "YOUR-PUBLISHER-ID",
  "author": {
    "name": "Hozaifa Bin Masud"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR-GITHUB-USERNAME/django-html-intellisense"
  },
  "bugs": {
    "url": "https://github.com/YOUR-GITHUB-USERNAME/django-html-intellisense/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "django",
    "django-html",
    "django templates",
    "html",
    "intellisense",
    "autocomplete",
    "attributes"
  ],
  "activationEvents": [
    "onLanguage:django-html"
  ],
  "main": "./extension.js",
  "contributes": {
    "htmlLanguageParticipants": [
      {
        "languageId": "django-html",
        "autoInsert": true
      }
    ]
  },
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0"
  }
}
